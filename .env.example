# Leave empty to use embedded PGlite (zero-install, real Postgres in WASM).
# For Supabase/Neon set e.g. postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL=

# Optional. Only used when running more than one app process against the SAME
# embedded PGlite directory is undesirable; embedded PGlite is single-process.
# Use Postgres (DATABASE_URL) for any multi-process or production deployment.
PGLITE_DIR=
